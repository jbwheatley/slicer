package build

import mill.*
import mill.scalalib.*

trait Spec extends ScalaModule {
  def scalaVersion = "2.13.16"

  override protected def semanticDbEnablePluginScalacOptions: T[Seq[String]] = Task {
    super.semanticDbEnablePluginScalacOptions() ++ Seq("-P:semanticdb:synthetics:on")
  }
}

object macros extends Spec {
  def mvnDeps = Seq(mvn"org.scala-lang:scala-reflect:2.13.16")
}

object base extends Spec {
  def moduleDeps = Seq(macros)
}

object external extends Spec {
  def moduleDeps = Seq(base)
  def mvnDeps = Seq(mvn"org.typelevel::cats-core:2.13.0")
}

object configured extends Spec {
  def scalacPluginMvnDeps = Seq(mvn"org.typelevel:::kind-projector:0.13.3")
  def compileMvnDeps = Seq(mvn"com.lihaoyi::sourcecode:0.4.2")
}

object entry extends Spec {
  def moduleDeps = Seq(base, external)
}
